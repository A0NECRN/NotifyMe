# Copy this file to .env and fill in your own Telegram Bot settings.
# Never commit your real .env file to GitHub.

TELEGRAM_TOKEN=1234567890:replace_with_your_bot_token
TELEGRAM_CHAT_ID=123456789

# Screenshot settings
SCREENSHOT_QUALITY=75
SCREENSHOT_MAX_WIDTH=1920

# Polling and idle thresholds
CHECK_INTERVAL=3
CPU_THRESHOLD=15.0
CPU_IDLE_DURATION=30
GPU_THRESHOLD=10.0
GPU_IDLE_DURATION=30

# Network settings
VERIFY_SSL=true
UPDATES_TIMEOUT=30
